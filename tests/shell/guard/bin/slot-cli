#!/bin/sh
# Fake SuiteCloud CLI for the guard's CLI slot cases (TNS_SUITECLOUD points
# here). Account lookups go straight to tests/bin/fake-suitecloud-guard.
# Every other call appends `start-u` to $FAKE_DIR/order, records its pid
# and the owner line of every lock under $TNS_CLI_SLOTS in $FAKE_DIR/slot-pid
# and slot-owners, sleeps $FAKE_DIR/hold seconds (default 0), appends
# `end-u` and then becomes the recording fake (same pid).
d=${FAKE_DIR:?FAKE_DIR is required}
fake=$(cd -P -- "$(dirname -- "$0")/../../../bin" && pwd -P)/fake-suitecloud-guard
if [ "${1-}" != account:manageauth ]; then
	echo start-u >>"$d/order"
	echo "$$" >"$d/slot-pid"
	: >"$d/slot-owners"
	for o in "${TNS_CLI_SLOTS:-/nonexistent}"/*/owner; do
		[ -f "$o" ] && { cat "$o"; echo; } >>"$d/slot-owners"
	done
	sleep "$(cat "$d/hold" 2>/dev/null || echo 0)"
	echo end-u >>"$d/order"
fi
exec "$fake" "$@"
